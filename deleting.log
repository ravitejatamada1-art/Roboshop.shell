R="\e[31m"
G="\e[32m"
Y="\e[33m"
N="\e[0m"
USERID=$(id -u)
LOGS_FOLDER="/var/log/shell-logs"
SCRIPT_NAME="deleting.log"
SOURCE_DIR=/home/ec2-user/app-logs
LOG_FILE="$LOGS_FOLDER/$SCRIPT_NAME"
mkdir -p $LOGS_FOLDER
if [ $USERID -eq 0 ]
then 
echo "you are Running with Root User" |tee -a $LOG_FILE
else
echo "Please run with Root User" |tee -a $LOG_FILE
fi
echo "script started executing at $(date)" |tee -a $LOG_FILE
FILES_TO_DELETE=$(find $SOURCE_DIR -name "*.log" -mtime +14)
while IFS= read -r filepath; do
    echo "Deleting $filepath" |tee -a $LOG_FILE
    rm -f "$filepath"
done <<< "$FILES_TO_DELETE"

echo "script executed successfully" | tee -a $LOG_FILE